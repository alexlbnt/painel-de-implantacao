# Copie para .env e preencha. Nunca versione o .env.

# Neon — conexão com pooling (usada pelo app)
DATABASE_URL=
# Neon — conexão direta (migrações, seed e Prisma Studio)
DATABASE_URL_UNPOOLED=

# Auth.js — gere com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET=

# Vercel Blob — upload de evidências (a partir da Sprint 4)
BLOB_READ_WRITE_TOKEN=

NEXT_PUBLIC_APP_NAME=Marco
NEXT_PUBLIC_ORG_NAME=Sua Empresa

# Apenas CI/build sem banco real: pula a validação das variáveis acima.
# SKIP_ENV_VALIDATION=1
